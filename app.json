{
  "expo": {
    "name": "Plantinha Sedenta",
    "slug": "plantinha-sedenta",
    "version": "1.0.0",
    "description": "Jogo para lembrar de beber água: cada copo faz a plantinha crescer.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1d2a",
    "primaryColor": "#4fc3ff",
    "ios": {
      "bundleIdentifier": "br.com.minanoideias.plantinhasedenta",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.minanoideias.plantinhasedenta",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0b1d2a"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Plantinha Sedenta",
      "shortName": "Plantinha",
      "lang": "pt-BR",
      "themeColor": "#0b1d2a",
      "backgroundColor": "#0b1d2a",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1d2a",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4fc3ff",
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/alarme.wav"
          ]
        }
      ],
      "expo-asset"
    ]
  }
}
